# DatasetForge Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/datasetforge"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# MinIO
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET="datasetforge"
