model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  name          String?
  profilePicture String?
  preferences   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  datasets      Dataset[]
  activityLogs  ActivityLog[]
  comments      Comment[]
  teamMembers   TeamMember[]
}
