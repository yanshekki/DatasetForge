model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // e.g. 'DATASET_SHARED', 'VERSION_UPLOADED', 'TEAM_INVITED'
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
