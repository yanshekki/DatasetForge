model ShareLink {
  id          Int      @id @default(autoincrement())
  datasetId   Int
  token       String   @unique
  permission  String   @default("READ") // READ or WRITE
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id])

  @@index([token])
}
